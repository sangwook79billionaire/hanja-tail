# ==========================================
# 한자 꼬리 (Hanja Tail) 환경 변수 가이드
# ==========================================
# 이 파일을 복사하여 '.env.local'로 이름을 바꾼 후 실제 키 값을 입력하세요.
# 디자이너는 UI 컴포넌트 작업 시 API 키 없이도 /design-system 페이지를 통해 작업할 수 있습니다.

# [Supabase] 데이터베이스 & 인증 연동 (Supabase 대시보드 > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# [Google Gemini AI] 퀴즈 생성 & 단어 분석 API (Google AI Studio)
GEMINI_API_KEY=your-gemini-api-key

# [NEIS API] 학교 검색 API (선택 사항)
NEIS_API_KEY=your-neis-api-key
